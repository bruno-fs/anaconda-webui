#!/bin/bash
# Push backend + webui changes to a running test VM and restart anaconda.
# Usage: test/push-and-reset ANACONDA_DIR [--port PORT] [--host HOST]
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WEBUI_DIR="$(dirname "$SCRIPT_DIR")"
ANACONDA_DIR=""
PORT=2201
HOST="127.0.0.2"

while [[ $# -gt 0 ]]; do
    case $1 in
        --port) PORT="$2"; shift 2 ;;
        --host) HOST="$2"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *) ANACONDA_DIR="$1"; shift ;;
    esac
done

if [ -z "$ANACONDA_DIR" ]; then
    echo "Usage: test/push-and-reset ANACONDA_DIR [--port PORT] [--host HOST]" >&2
    exit 1
fi

SSH_OPTS="-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o ConnectTimeout=5"
SITE_PACKAGES="/usr/lib64/python3.15/site-packages"

echo "Pushing pyanaconda..."
rsync -az --delete \
    -e "ssh $SSH_OPTS -p $PORT" \
    "$ANACONDA_DIR/pyanaconda/" "root@${HOST}:${SITE_PACKAGES}/pyanaconda/"

if [ -d "$WEBUI_DIR/dist" ] && [ -f "$WEBUI_DIR/dist/manifest.json" ]; then
    echo "Pushing webui dist..."
    rsync -az --delete \
        -e "ssh $SSH_OPTS -p $PORT" \
        "$WEBUI_DIR/dist/" "root@${HOST}:/usr/share/cockpit/anaconda-webui/"
fi

"$SCRIPT_DIR/reset-installation-status" "$PORT"

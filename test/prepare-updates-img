#!/bin/bash

set -eu

TEST_RPMS="${TEST_RPMS:-""}"
BUILD_RPMS_IMAGE="${TEST_OS/\-boot/}"
COMPOSE_ID="${TEST_COMPOSE:-""}"

# Prepare tmp/rpms folder with anaconda-webui missing dependencies
test/vm.install -v --image=$BUILD_RPMS_IMAGE --compose=$COMPOSE_ID

# Copy the extra RPMs to the /tmp/rpms directory
for i in ${TEST_RPMS//,/ }; do
    echo "Copying $i to tmp/rpms"
    cp $i tmp/rpms
done

# makeupdates must be run from the top level of the anaconda source tree
# shellcheck disable=SC2086,SC2046
MYPARAMS=()
for p in tmp/rpms/*.rpm; do
  MYPARAMS+=("--add" "$p")
done
scripts/makeupdates "${MYPARAMS[@]}"

# If ANACONDA_DIR is set, build an anaconda updates overlay and merge it
# into the webui updates.img. Faster than building full RPMs.
if [ -n "${ANACONDA_DIR:-}" ]; then
    echo "Building anaconda updates from $ANACONDA_DIR"
    anaconda_tag=$(cd "$ANACONDA_DIR" && git describe --tags --abbrev=0 2>/dev/null || echo "HEAD~1")
    (cd "$ANACONDA_DIR" && ./scripts/makeupdates -t "$anaconda_tag")
    webui_img="$(realpath updates.img)"
    tmpdir=$(mktemp -d)
    (cd "$tmpdir" && gzip -dc "$webui_img" | cpio -idmu 2>/dev/null)
    (cd "$tmpdir" && gzip -dc "$ANACONDA_DIR/updates.img" | cpio -idmu 2>/dev/null)
    (cd "$tmpdir" && find . | cpio -c -o 2>/dev/null | gzip -9 > merged.img)
    mv "$tmpdir/merged.img" "$webui_img"
    rm -rf "$tmpdir"
fi

cp updates.img updates-${BUILD_RPMS_IMAGE}.img
